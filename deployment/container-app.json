{
  "schemaVersion": 1,
  "artifactClass": "web-with-backend",
  "resourceGroup": "sociobot",
  "environment": "factory-env",
  "appName": "sf-code-lesson-checkpoints",
  "publicUrl": "https://code-lesson-checkpoints.sociobot.in",
  "registry": "sociobotregistry",
  "imageRepository": "sf-code-lesson-checkpoints",
  "targetPort": 8080,
  "activeRevisionsMode": "Single",
  "scale": {
    "minReplicas": 3,
    "maxReplicas": 3
  },
  "postgres": {
    "keyVault": "sociobot-keyvault1",
    "migrationKeyVaultSecret": "sociobot-db-migration-url",
    "keyVaultSecret": "sociobot-db-runtime-url",
    "containerSecret": "code-lesson-checkpoints-database-url",
    "schema": "code_lesson_checkpoints"
  },
  "coherenceProbe": {
    "cycles": 4,
    "minimumDistinctReplicas": 2
  }
}
